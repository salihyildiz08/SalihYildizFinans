@page
@model SalihYildizFinans.Pages.Users.IndexModel
@{
    ViewData["Title"] = "Kullanıcı Yönetimi";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark">Kullanıcılar</h3>
        <p class="text-secondary mb-0">Sistemdeki kullanıcıları yönetin.</p>
    </div>
    <a asp-page="Create" class="btn btn-primary rounded-pill px-4 shadow-sm">
        <i class="fas fa-user-plus me-2"></i> Yeni Kullanıcı
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-secondary small">
                    <tr>
                        <th class="ps-4">AD SOYAD</th>
                        <th>KULLANICI ADI</th>
                        <th>E-POSTA</th>
                        <th>ROL</th>
                        <th class="text-end pe-4">İŞLEMLER</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model.Users)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center">
                                    <div class="bg-light rounded-circle p-2 me-3 text-secondary">
                                        <i class="fas fa-user"></i>
                                    </div>
                                    <div class="fw-bold text-dark">@user.FirstName @user.LastName</div>
                                </div>
                            </td>
                            <td>@user.UserName</td>
                            <td>@user.Email</td>
                            <td>
                                @if (Model.UserRoles.ContainsKey(user.Id) && Model.UserRoles[user.Id].Contains("Admin"))
                                {
                                    <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill">Admin</span>
                                }
                                else
                                {
                                    <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill">Kullanıcı</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <a asp-page="./Edit" asp-route-id="@user.Id" class="btn btn-sm btn-light text-primary me-1" title="Düzenle">
                                    <i class="fas fa-edit"></i>
                                </a>
                                 <a asp-page="./Delete" asp-route-id="@user.Id" class="btn btn-sm btn-light text-danger" title="Sil">
                                    <i class="fas fa-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
