@page
@model SalihYildizFinans.Pages.Taksitler.IndexModel
@{
    ViewData["Title"] = "Taksitli İşlemler";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-center mb-4 gap-3">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a href="/" class="text-decoration-none small">Anasayfa</a></li>
                <li class="breadcrumb-item active small" aria-current="page">Taksitli İşlemler</li>
            </ol>
        </nav>
        <h2 class="fw-bold text-dark">Borç & Alacak Takibi</h2>
        <p class="text-secondary mb-0">Taksitli işlemlerinizi ve kişi bazlı özetlerinizi yönetin.</p>
    </div>
    
    <button class="btn btn-primary rounded-pill px-4 shadow-sm" onclick="openCreateModal()">
        <i class="fas fa-plus me-2"></i> Yeni Taksitli İşlem
    </button>
</div>

<!-- Kişi Bazlı Raporlama -->
@if (Model.Summaries.Any())
{
    <div class="row g-3 mb-4">
        @foreach (var s in Model.Summaries)
        {
            <div class="col-lg-6 col-xl-4">
                <div class="card border-0 shadow-sm overflow-hidden h-100">
                    <div class="bg-primary p-3 text-white d-flex justify-content-between align-items-center">
                        <span class="fw-bold fs-5"><i class="fas fa-user me-2"></i> @s.PersonName</span>
                        <span class="badge bg-white text-primary">Aktif Taksitler</span>
                    </div>
                    <div class="card-body p-3">
                        <div class="row g-2">
                            <div class="col-6">
                                <div class="bg-light p-2 rounded text-center">
                                    <div class="small text-secondary">Toplam Borç</div>
                                    <div class="fw-bold text-dark">@s.TotalBorc.ToString("N2") ₺</div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="bg-light p-2 rounded text-center">
                                    <div class="small text-secondary">Toplam Alacak</div>
                                    <div class="fw-bold text-success">@s.TotalAlacak.ToString("N2") ₺</div>
                                </div>
                            </div>
                            <div class="col-12 mt-2">
                                <div class="bg-warning bg-opacity-10 border border-warning border-opacity-20 p-2 rounded text-center">
                                    <div class="small text-secondary text-uppercase fw-bold" style="font-size: 10px;">Bu Ay Ödenecek / Alınacak</div>
                                    <div class="fw-bold text-warning">@s.ThisMonthTotal.ToString("N2") ₺</div>
                                </div>
                            </div>
                            <div class="col-6 mt-2">
                                <div class="border-start border-danger border-4 ps-2">
                                    <div class="small text-secondary">Kalan Borç</div>
                                    <div class="fw-bold text-danger">@s.RemainingBorc.ToString("N2") ₺</div>
                                </div>
                            </div>
                            <div class="col-6 mt-2">
                                <div class="border-start border-info border-4 ps-2">
                                    <div class="small text-secondary">Kalan Alacak</div>
                                    <div class="fw-bold text-info">@s.RemainingAlacak.ToString("N2") ₺</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

<!-- Tablo -->
<div class="card p-4 border-0 shadow-sm">
    <div class="table-responsive">
        <table id="taksitTable" class="table table-hover align-middle w-100 text-nowrap">
            <thead>
                <tr>
                    <th>Tarih</th>
                    <th>Kişi</th>
                    <th>Açıklama</th>
                    <th>Tip</th>
                    <th>Taksit (Kalan/Toplam)</th>
                    <th>Toplam Tutar</th>
                    <th>Aylık Tutar</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.Date.ToShortDateString()</td>
                        <td class="fw-bold">@item.PersonName</td>
                        <td class="fw-bold">@item.Description</td>
                        <td>
                            @if(item.Type == SalihYildizFinans.Models.DebtTrackerType.Borc) {
                                <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-20">BORÇ</span>
                            } else {
                                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-20">ALACAK</span>
                            }
                        </td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                
                                <span class="fw-bold">@item.RemainingInstallments / @item.TotalInstallments</span>
                            </div>
                        </td>
                        <td class="fw-bold text-dark">@item.TotalAmount.ToString("N2") ₺</td>
                        <td class="text-primary fw-bold">@item.MonthlyAmount.ToString("N2") ₺</td>
                        <td class="text-end">
                            <form method="post" asp-page-handler="ReduceInstallment" asp-route-id="@item.Id" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-primary" title="Taksit Azalt">
                                    <i class="fas fa-minus-circle"></i> Taksit Düş
                                </button>
                            </form>
                            <button class="btn btn-sm btn-light text-primary mx-1" onclick="openEditModal(@item.Id, '@item.PersonName', '@((int)item.Type)', @item.TotalInstallments, @item.RemainingInstallments, '@item.TotalAmount', '@item.MonthlyAmount', '@item.Description', '@item.Date.ToString("yyyy-MM-dd")')">
                                <i class="fas fa-edit"></i>
                            </button>
                            <form method="post" asp-page-handler="Delete" asp-route-id="@item.Id" class="d-inline" id="deleteTaksitForm_@item.Id">
                                <button type="button" class="btn btn-sm btn-light text-danger" onclick="confirmDelete('deleteTaksitForm_@item.Id')">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Kayıt/Düzenle Modal -->
<div class="modal fade" id="itemModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-light border-0">
                <h5 class="modal-title fw-bold" id="modalTitle">Yeni Taksitli İşlem</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" id="itemForm">
                <input type="hidden" name="Id" id="inId" value="0">
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-secondary">Kişi Adı</label>
                            <input type="text" class="form-control" name="PersonName" id="inPerson" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-secondary">İşlem Tipi</label>
                            <select class="form-select" name="Type" id="inType">
                                <option value="0">Borç</option>
                                <option value="1">Alacak</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-bold small text-secondary">Toplam Taksit</label>
                            <input type="number" class="form-control" name="TotalInstallments" id="inTotalIns" value="1" min="1">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-bold small text-secondary">Kalan Taksit</label>
                            <input type="number" class="form-control" name="RemainingInstallments" id="inRemIns" value="1" min="0">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-bold small text-secondary">Toplam Tutar</label>
                            <div class="input-group">
                                <span class="input-group-text">₺</span>
                                <input type="text" class="form-control" name="TotalAmount" id="inTotalAmt" placeholder="0,00" required>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-bold small text-secondary">Aylık Tutar</label>
                            <div class="input-group">
                                <span class="input-group-text">₺</span>
                                <input type="text" class="form-control" name="MonthlyAmount" id="inMonthlyAmt" placeholder="0,00" required>
                            </div>
                        </div>
                        <div class="col-md-8">
                            <label class="form-label fw-bold small text-secondary">Açıklama</label>
                            <input type="text" class="form-control" name="Description" id="inDesc">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold small text-secondary">Tarih</label>
                            <input type="date" class="form-control" name="Date" id="inDate" value="@DateTime.Now.ToString("yyyy-MM-dd")">
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 p-4">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-primary px-4">Kaydet</button>
                </div>
            </form>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        $(document).ready(function() {
            $('#taksitTable').DataTable({
                "language": { "url": "//cdn.datatables.net/plug-ins/1.13.4/i18n/tr.json" },
                "ordering": false
            });

            // OTOMATİK HESAPLAMA MANTIĞI
            const $totalIns = $('#inTotalIns');
            const $remIns = $('#inRemIns');
            const $totalAmt = $('#inTotalAmt');
            const $monthlyAmt = $('#inMonthlyAmt');
            const $inId = $('#inId');

            function parseLocaleNumber(stringNumber) {
                if (!stringNumber) return 0;
                // Virgülü noktaya çevir, boşlukları temizle
                var number = parseFloat(stringNumber.toString().replace(',', '.').replace(/\s/g, ''));
                return isNaN(number) ? 0 : number;
            }

            function formatLocaleNumber(number) {
                 return number.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            }

            function calculateMonthly() {
                const totalVal = $totalAmt.val();
                if (!totalVal) return;

                const total = parseLocaleNumber(totalVal);
                const ins = parseInt($totalIns.val()) || 1;
                if (ins > 0 && total > 0) {
                    const monthly = total / ins;
                    $monthlyAmt.val(formatLocaleNumber(monthly));
                }
            }

            $totalAmt.on('input change', calculateMonthly);
            $totalIns.on('input change', function() {
                if ($inId.val() == "0") {
                    $remIns.val($totalIns.val());
                }
                calculateMonthly();
            });
        });

        var itemModal, deleteModal;
        
        function openCreateModal() {
            if(!itemModal) itemModal = new bootstrap.Modal(document.getElementById('itemModal'));
            document.getElementById('modalTitle').innerText = 'Yeni Taksitli İşlem';
            document.getElementById('itemForm').action = '?handler=Create';
            document.getElementById('inId').value = '0';
            document.getElementById('inPerson').value = '';
            document.getElementById('inType').value = '0';
            document.getElementById('inTotalIns').value = '1';
            document.getElementById('inRemIns').value = '1';
            document.getElementById('inTotalAmt').value = '';
            document.getElementById('inMonthlyAmt').value = '';
            document.getElementById('inDesc').value = '';
            itemModal.show();
        }

        function openEditModal(id, person, type, totalIns, remIns, totalAmt, monthlyAmt, desc, date) {
            if(!itemModal) itemModal = new bootstrap.Modal(document.getElementById('itemModal'));
            document.getElementById('modalTitle').innerText = 'İşlemi Düzenle';
            document.getElementById('itemForm').action = '?handler=Update';
            document.getElementById('inId').value = id;
            document.getElementById('inPerson').value = person;
            document.getElementById('inType').value = type;
            document.getElementById('inTotalIns').value = totalIns;
            document.getElementById('inRemIns').value = remIns;
            // Tutarları olduğu gibi (virgüllü geliyorsa virgüllü) basıyoruz, zaten type="text" yaptık
            document.getElementById('inTotalAmt').value = totalAmt;
            document.getElementById('inMonthlyAmt').value = monthlyAmt;
            document.getElementById('inDesc').value = desc;
            document.getElementById('inDate').value = date;
            itemModal.show();
        }

        function openDeleteModal(id) {
             // Deleted - Using global confirmDelete instead
        }
    </script>
}
