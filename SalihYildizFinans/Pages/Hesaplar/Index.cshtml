@page
@model SalihYildizFinans.Pages.Hesaplar.IndexModel
@{
    ViewData["Title"] = "Hesap Para Bilgileri";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-center mb-4 gap-3">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a href="/" class="text-decoration-none small">Anasayfa</a></li>
                <li class="breadcrumb-item active small" aria-current="page">Hesap Para</li>
            </ol>
        </nav>
        <h2 class="fw-bold text-dark">Hesap Para Takibi</h2>
        <p class="text-secondary mb-0">Hesap bakiyelerinizi ve hareketlerini tek bir yerden yönetin.</p>
    </div>
    
    <button class="btn btn-primary rounded-pill px-4 shadow-sm" data-bs-toggle="modal" data-bs-target="#createAccountModal">
        <i class="fas fa-plus me-2"></i> Yeni Hesap Ekle
    </button>
</div>

<div class="row g-4">
    @foreach (var account in Model.Accounts)
    {
        <div class="col-md-6 col-lg-4 col-xl-3">
            <div class="card border-0 shadow-sm h-100 overflow-hidden position-relative">
                <div class="card-body p-4 text-center">
                    <div class="mb-3">
                        <div class="bg-primary bg-opacity-10 text-primary d-inline-flex align-items-center justify-content-center rounded-circle mb-2" style="width: 60px; height: 60px; font-size: 24px;">
                            <i class="fas fa-wallet"></i>
                        </div>
                        <h5 class="fw-bold mb-0">@account.PersonName</h5>
                        <span class="badge bg-light text-secondary border">@account.CurrencyType</span>
                    </div>
                    
                    <div class="mb-4">
                        <div class="small text-secondary text-uppercase ls-1 mb-1">Toplam Bakiye</div>
                        <h3 class="fw-bold @(account.TotalAmount >= 0 ? "text-success" : "text-danger") mb-0">
                            @account.TotalAmount.ToString("N2") 
                            <small class="fs-6 fw-normal">@account.CurrencyType</small>
                        </h3>
                    </div>

                    <div class="d-flex gap-2 justify-content-center">
                        <button class="btn btn-outline-primary btn-sm rounded-pill px-3" onclick="openDetailsModal(@account.Id, '@account.PersonName')">
                            <i class="fas fa-list-ul me-1"></i> Detaylar
                        </button>
                        <button class="btn btn-light btn-sm rounded-pill px-3" onclick="openEditAccountModal(@account.Id, '@account.PersonName', '@account.CurrencyType')">
                            <i class="fas fa-edit"></i>
                        </button>
                        <form method="post" asp-page-handler="DeleteAccount" asp-route-id="@account.Id" class="d-inline" id="deleteAccForm_@account.Id">
                            <button type="button" class="btn btn-light btn-sm rounded-pill px-3 text-danger" onclick="confirmDelete('deleteAccForm_@account.Id', 'Hesabı Sil?', 'Bu hesaba ait TÜM hareketler de silinecektir!')">
                                <i class="fas fa-trash"></i>
                            </button>
                        </form>
                    </div>
                </div>
                
                @if (account.Details.Any())
                {
                    <div class="card-footer bg-light border-0 py-2 text-center">
                        <small class="text-secondary">Son İşlem: @account.Details.OrderByDescending(d => d.Date).First().Date.ToShortDateString()</small>
                    </div>
                }
            </div>
        </div>
    }
</div>

@if (!Model.Accounts.Any())
{
    <div class="text-center py-5">
        <div class="mb-3 text-secondary" style="font-size: 64px;">
            <i class="fas fa-folder-open"></i>
        </div>
        <h4 class="text-secondary">Henüz bir hesap eklenmemiş.</h4>
        <p class="text-muted">Başlamak için sağ üstteki "Yeni Hesap Ekle" butonuna tıklayın.</p>
    </div>
}

<!-- Create Account Modal -->
<div class="modal fade" id="createAccountModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-light border-0">
                <h5 class="modal-title fw-bold">Yeni Hesap Oluştur</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" asp-page-handler="CreateAccount">
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-secondary">Kişi Adı</label>
                        <input type="text" class="form-control" name="PersonName" required placeholder="Örn: Ahmet Yılmaz">
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-secondary">Döviz Tipi</label>
                        <select class="form-select" name="CurrencyType" required>
                            <option value="₺">Türk Lirası (₺)</option>
                            <option value="$">Dolar ($)</option>
                            <option value="€">Euro (€)</option>
                            <option value="ALTIN">Altın (Gram)</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer border-0 p-4 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4">Oluştur</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Account Modal -->
<div class="modal fade" id="editAccountModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-light border-0">
                <h5 class="modal-title fw-bold">Hesap Düzenle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" asp-page-handler="UpdateAccount">
                <input type="hidden" id="editAccountId" name="Id" />
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-secondary">Kişi Adı</label>
                        <input type="text" class="form-control" id="editPersonName" name="PersonName" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-secondary">Döviz Tipi</label>
                        <select class="form-select" id="editCurrencyType" name="CurrencyType" required>
                            <option value="₺">Türk Lirası (₺)</option>
                            <option value="$">Dolar ($)</option>
                            <option value="€">Euro (€)</option>
                            <option value="ALTIN">Altın (Gram)</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer border-0 p-4 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4">Güncelle</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Details Modal -->
<div class="modal fade" id="detailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-primary text-white border-0">
                <h5 class="modal-title fw-bold" id="detailsTitle">Hesap Hareketleri</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0">
                <div class="p-4 border-bottom bg-light">
                    <h6 class="fw-bold mb-3"><i class="fas fa-plus-circle me-1"></i> Yeni Hareket Ekle</h6>
                    <form method="post" asp-page-handler="AddDetail">
                        <input type="hidden" name="accountId" id="detailAccountId" />
                        <div class="row g-2">
                            <div class="col-md-3">
                                <label class="form-label small text-secondary mb-1">Tutar (+ veya -)</label>
                                <input type="number" step="0.01" class="form-control" name="amount" required placeholder="0.00">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small text-secondary mb-1">Açıklama</label>
                                <input type="text" class="form-control" name="description" placeholder="Örn: Gelen Ödeme">
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small text-secondary mb-1">Tarih</label>
                                <input type="date" class="form-control" name="date" value="@DateTime.Now.ToString("yyyy-MM-dd")">
                            </div>
                            <div class="col-md-2 d-flex align-items-end">
                                <button type="submit" class="btn btn-primary w-100 rounded">Ekle</button>
                            </div>
                        </div>
                    </form>
                </div>
                
                <div class="p-4">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle" id="detailsTable">
                            <thead class="bg-light">
                                <tr>
                                    <th>Tarih</th>
                                    <th>Açıklama</th>
                                    <th class="text-end">Tutar</th>
                                    <th class="text-center">İşlemler</th>
                                </tr>
                            </thead>
                            <tbody id="detailsTbody">
                                <!-- JS ile doldurulacak -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Edit Detail Modal -->
<div class="modal fade" id="editDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-light border-0">
                <h5 class="modal-title fw-bold">Hareket Düzenle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" asp-page-handler="UpdateDetail">
                <input type="hidden" id="editDetailId" name="id" />
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-secondary">Tutar (+ veya -)</label>
                        <input type="number" step="0.01" class="form-control" id="editDetailAmount" name="amount" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-secondary">Açıklama</label>
                        <input type="text" class="form-control" id="editDetailDescription" name="description">
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-secondary">Tarih</label>
                        <input type="date" class="form-control" id="editDetailDate" name="date" required>
                    </div>
                </div>
                <div class="modal-footer border-0 p-4 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" onclick="$('#editDetailModal').modal('hide'); $('#detailsModal').modal('show');">İptal</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4">Güncelle</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openEditAccountModal(id, name, currency) {
            $('#editAccountId').val(id);
            $('#editPersonName').val(name);
            $('#editCurrencyType').val(currency);
            $('#editAccountModal').modal('show');
        }

        function openDetailsModal(id, name) {
            $('#detailAccountId').val(id);
            $('#detailsTitle').html('<i class="fas fa-wallet me-2"></i> ' + name + ' - Hesap Hareketleri');
            
            var tbody = $('#detailsTbody');
            tbody.empty();

            @foreach (var account in Model.Accounts)
            {
                <text>
                if (id === @account.Id) {
                    @foreach (var detail in account.Details.OrderByDescending(d => d.Date))
                    {
                        <text>
                        var row = `<tr>
                            <td>@detail.Date.ToShortDateString()</td>
                            <td>@detail.Description</td>
                            <td class="text-end fw-bold @(detail.Amount >= 0 ? "text-success" : "text-danger")">@detail.Amount.ToString("N2")</td>
                            <td class="text-center">
                                <button class="btn btn-link py-0 text-primary" onclick="openEditDetailModal(@detail.Id, @detail.Amount.ToString(System.Globalization.CultureInfo.InvariantCulture), '@detail.Description', '@detail.Date.ToString("yyyy-MM-dd")')" title="Düzenle">
                                    <i class="fas fa-edit"></i>
                                </button>
                                <form method="post" asp-page-handler="DeleteDetail" asp-route-detailId="@detail.Id" class="d-inline" id="deleteDetailForm_@detail.Id">
                                    <button type="button" class="btn btn-link py-0 text-danger" title="Sil" onclick="confirmDelete('deleteDetailForm_@detail.Id')"><i class="fas fa-times"></i></button>
                                </form>
                            </td>
                        </tr>`;
                        tbody.append(row);
                        </text>
                    }
                }
                </text>
            }
            
            if (tbody.children().length === 0) {
                tbody.append('<tr><td colspan="4" class="text-center text-muted py-3">Henüz hareket bulunmuyor.</td></tr>');
            }

            $('#detailsModal').modal('show');
        }

        function openEditDetailModal(id, amount, desc, date) {
            $('#detailsModal').modal('hide');
            $('#editDetailId').val(id);
            $('#editDetailAmount').val(amount);
            $('#editDetailDescription').val(desc);
            $('#editDetailDate').val(date);
            $('#editDetailModal').modal('show');
        }
    </script>
}
