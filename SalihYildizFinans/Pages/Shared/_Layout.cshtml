@using Microsoft.AspNetCore.Identity
@using SalihYildizFinans.Models
@inject UserManager<AppUser> UserManager
@inject SignInManager<AppUser> SignInManager

@{
    var user = await UserManager.GetUserAsync(User);
    var displayName = user != null ? $"{user.FirstName} {user.LastName}" : User.Identity?.Name;
    
    // Calculate Initials
    var initials = "SY"; // Default fallback
    if (user != null && !string.IsNullOrEmpty(user.FirstName) && !string.IsNullOrEmpty(user.LastName))
    {
        try {
            initials = $"{user.FirstName[0]}{user.LastName[0]}".ToUpper();
        } catch {}
    }
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @initials Finans</title>
    
    <!-- Bootstrap 5 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css" />
    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <!-- DataTables -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.4/css/dataTables.bootstrap5.min.css" />
    <!-- Toastr -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
    <!-- SweetAlert2 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

    <!-- Sidebar -->
    <nav id="sidebar" class="sidebar">
        <div class="sidebar-header">
            <a href="/" class="brand-logo">
                <i class="fas fa-wallet"></i>
                <span>@initials Finans</span>
            </a>
        </div>
        <div class="sidebar-menu">
            <ul class="list-unstyled">
                <li>
                     <a href="/Taksitler" class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Taksitler" ? "active" : "")">
                        <i class="fas fa-calendar-alt"></i> Taksitli İşlemler
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Borclar" ? "active" : "")" asp-page="/Borclar">
                        <i class="fas fa-file-invoice me-2"></i> Ekstre
                    </a>
                </li>
                <li>
                    <a href="/" class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Index" ? "active" : "")">
                        <i class="fas fa-chart-line"></i> Ekstre Rapor
                    </a>
                </li>
                <li class="nav-item">
                     <a href="/Tarlalar" class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Tarlalar/Index" ? "active" : "")">
                        <i class="fas fa-tractor"></i> Tarla Hesap
                    </a>
                </li>
                @if (User.IsInRole("Admin"))
                {
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Bankalar/Index" ? "active" : "")" asp-page="/Bankalar/Index">
                            <i class="fas fa-university me-2"></i> Bankalar
                        </a>
                    </li>
                }
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Hesaplar/Index" ? "active" : "")" asp-page="/Hesaplar/Index">
                        <i class="fas fa-wallet me-2"></i> Hesap Para
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Doviz/Index" ? "active" : "")" asp-page="/Doviz/Index">
                        <i class="fas fa-coins me-2"></i> Döviz Hesabı
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Arac/Index" ? "active" : "")" asp-page="/Arac/Index">
                        <i class="fas fa-car me-2"></i> Araç Alış Satış
                    </a>
                </li>
                <li>
                     <a href="/Izinler" class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Izinler" ? "active" : "")">
                        <i class="fas fa-user-shield"></i> İzinler
                    </a>
                </li>
                
                @if (User.IsInRole("Admin"))
                {
                    <li class="mt-3 ps-3 text-uppercase text-muted fw-bold" style="font-size: 0.75rem;">YÖNETİM</li>
                    <li>
                        <a href="/Users/Index" class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Users/Index" ? "active" : "")">
                            <i class="fas fa-users-cog"></i> Kullanıcılar
                        </a>
                    </li>
                    <li>
                        <a href="/Admin/SystemInfo" class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Admin/SystemInfo" ? "active" : "")">
                            <i class="fas fa-server"></i> Sistem Bilgisi
                        </a>
                    </li>
                }

                <li class="mt-4">
                    <form class="form-inline" asp-area="" asp-page="/Login" asp-page-handler="Logout" method="post" id="logoutForm">
                        <button type="submit" class="nav-link text-danger border-0 bg-transparent w-100 text-start">
                            <i class="fas fa-sign-out-alt"></i> Çıkış Yap
                        </button>
                    </form>
                </li>
            </ul>
        </div>
    </nav>

    <!-- Main Content -->
    <div class="main-content" id="content">
        <!-- Top Navbar -->
        <nav class="navbar navbar-expand-lg top-navbar">
            <div class="container-fluid">
                <button type="button" id="sidebarCollapse" class="btn btn-light d-md-none">
                    <i class="fas fa-bars"></i>
                </button>
                <h4 class="mb-0 ms-3 text-secondary">@ViewData["Title"]</h4>
                
                <div class="ms-auto d-flex align-items-center">
                    <div class="dropdown">
                        <a href="#" class="d-flex align-items-center text-decoration-none dropdown-toggle" id="dropdownUser1" data-bs-toggle="dropdown" aria-expanded="false">
                            <img src="https://ui-avatars.com/api/?name=@displayName&background=1a237e&color=fff" alt="" width="32" height="32" class="rounded-circle me-2">
                            <strong class="text-dark d-none d-sm-inline">@displayName</strong>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end text-small shadow" aria-labelledby="dropdownUser1">
                            <li><a class="dropdown-item" asp-page="/Profile"><i class="fas fa-user-circle me-2"></i> Profilim</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form class="form-inline" asp-area="" asp-page="/Login" asp-page-handler="Logout" method="post">
                                     <button type="submit" class="dropdown-item text-danger"><i class="fas fa-sign-out-alt me-2"></i> Çıkış Yap</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </nav>

        <div class="content-body">
            @RenderBody()
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.4/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.4/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- Global Spinner -->
    <div id="global-spinner" class="d-none position-fixed top-0 start-0 w-100 h-100 d-flex justify-content-center align-items-center bg-white bg-opacity-75" style="z-index: 9999;">
        <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
            <span class="visually-hidden">Yükleniyor...</span>
        </div>
    </div>

    <script>
        $(document).ready(function () {
            // Show spinner on form submit
            $('form').on('submit', function () {
                if ($(this).valid()) {
                    $('#global-spinner').removeClass('d-none');
                }
            });

            // Show spinner on AJAX start/stop (if any global ajax used)
            $(document).ajaxStart(function () {
                $('#global-spinner').removeClass('d-none');
            }).ajaxStop(function () {
                $('#global-spinner').addClass('d-none');
            });
            
            // Sidebar toggle
            $('#sidebarCollapse').on('click', function () {
                $('#sidebar').toggleClass('active');
            });
            
            // Toastr global config

            toastr.options = {
                "closeButton": true,
                "progressBar": true,
                "positionClass": "toast-top-right",
                "timeOut": "3000"
            };

            // TempData Notifications
            @if (TempData["Message"] != null)
            {
                <text>toastr.success('@TempData["Message"]');</text>
            }
            @if (TempData["Error"] != null)
            {
                <text>toastr.error('@TempData["Error"]');</text>
            }
        });

        // Global Delete Confirmation
        function confirmDelete(formId, title = 'Emin misiniz?', text = 'Bu işlem geri alınamaz!') {
            Swal.fire({
                title: title,
                text: text,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Evet, Sil!',
                cancelButtonText: 'Vazgeç'
            }).then((result) => {
                if (result.isConfirmed) {
                    document.getElementById(formId).submit();
                }
            });
            return false;
        }
    </script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>