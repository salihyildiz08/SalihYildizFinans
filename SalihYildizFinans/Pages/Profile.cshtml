@page
@model SalihYildizFinans.Pages.ProfileModel
@{
    ViewData["Title"] = "Profilim";
}

<div class="row mb-4">
    <div class="col-md-12">
        <h3 class="fw-bold text-dark">Hesap Ayarları</h3>
        <p class="text-secondary">Profil bilgilerinizi ve güvenliğinizi yönetin.</p>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    var statusClass = Model.StatusMessage.StartsWith("Hata") ? "danger" : "success";
    <div class="alert alert-@statusClass alert-dismissible fade show mb-4" role="alert">
        @Model.StatusMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row g-4">
    <!-- Profil Bilgileri -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-0 py-3">
                <div class="d-flex align-items-center">
                    <div class="bg-primary bg-opacity-10 p-2 rounded-circle me-3">
                        <i class="fas fa-user-edit text-primary"></i>
                    </div>
                    <h5 class="fw-bold mb-0">Kimlik Bilgileri</h5>
                </div>
            </div>
            <div class="card-body p-4">
                <form id="profile-form" method="post" asp-page-handler="UpdateProfile">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Input.FirstName" class="form-label fw-bold small text-secondary"></label>
                            <input asp-for="Input.FirstName" class="form-control" />
                            <span asp-validation-for="Input.FirstName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Input.LastName" class="form-label fw-bold small text-secondary"></label>
                            <input asp-for="Input.LastName" class="form-control" />
                            <span asp-validation-for="Input.LastName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-12">
                            <label asp-for="Input.Username" class="form-label fw-bold small text-secondary"></label>
                            <input asp-for="Input.Username" class="form-control" />
                            <span asp-validation-for="Input.Username" class="text-danger small"></span>
                        </div>
                        <div class="col-md-12">
                            <label asp-for="Input.PhoneNumber" class="form-label fw-bold small text-secondary"></label>
                            <input asp-for="Input.PhoneNumber" class="form-control" placeholder="05XX XXX XX XX" />
                            <span asp-validation-for="Input.PhoneNumber" class="text-danger small"></span>
                        </div>
                        <div class="col-12 mt-4">
                            <button type="submit" class="btn btn-primary w-100 py-2 rounded-pill shadow-sm">
                                <i class="fas fa-save me-2"></i> Bilgileri Güncelle
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Şifre Değiştirme -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-0 py-3">
                <div class="d-flex align-items-center">
                    <div class="bg-danger bg-opacity-10 p-2 rounded-circle me-3">
                        <i class="fas fa-lock text-danger"></i>
                    </div>
                    <h5 class="fw-bold mb-0">Şifre Değiştir</h5>
                </div>
            </div>
            <div class="card-body p-4">
                <form id="change-password-form" method="post" asp-page-handler="ChangePassword">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
                    
                    <div class="mb-3">
                        <label asp-for="PasswordInput.OldPassword" class="form-label fw-bold small text-secondary"></label>
                        <input asp-for="PasswordInput.OldPassword" class="form-control" />
                        <span asp-validation-for="PasswordInput.OldPassword" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="PasswordInput.NewPassword" class="form-label fw-bold small text-secondary"></label>
                        <input asp-for="PasswordInput.NewPassword" class="form-control" />
                        <span asp-validation-for="PasswordInput.NewPassword" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="PasswordInput.ConfirmPassword" class="form-label fw-bold small text-secondary"></label>
                        <input asp-for="PasswordInput.ConfirmPassword" class="form-control" />
                        <span asp-validation-for="PasswordInput.ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <div class="mt-4">
                         <button type="submit" class="btn btn-outline-danger w-100 py-2 rounded-pill">
                            <i class="fas fa-key me-2"></i> Şifreyi Değiştir
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
