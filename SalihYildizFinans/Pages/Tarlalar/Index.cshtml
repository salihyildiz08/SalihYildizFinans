@page
@model SalihYildizFinans.Pages.Tarlalar.IndexModel
@{
    ViewData["Title"] = "Tarla Hesap Yönetimi";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-center mb-4 gap-3">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a href="/" class="text-decoration-none small">Anasayfa</a></li>
                <li class="breadcrumb-item active small" aria-current="page">Tarla Hesapları</li>
            </ol>
        </nav>
        <h2 class="fw-bold text-dark">Tarla Hesap Takibi</h2>
        <p class="text-secondary mb-0">Tarla alım-satım ve ödeme süreçlerinizi yönetin.</p>
    </div>
    
    <button class="btn btn-success rounded-pill px-4 shadow-sm" data-bs-toggle="modal" data-bs-target="#createModal">
        <i class="fas fa-plus me-2"></i> Yeni Kayıt Ekle
    </button>
</div>

<!-- Summary Reports -->
<div class="row g-4 mb-5">
    <!-- Currency Summary -->
    <div class="col-12 col-xl-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-light border-0 py-3">
                <h6 class="fw-bold mb-0 text-primary"><i class="fas fa-coins me-2"></i> Döviz Bazlı Genel Durum</h6>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light small text-uppercase">
                            <tr>
                                <th class="ps-4">Döviz</th>
                                <th class="text-end">Toplam</th>
                                <th class="text-end">Ödenen</th>
                                <th class="text-end pe-4">Kalan</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in Model.CurrencySummaries)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold">@s.Label</td>
                                    <td class="text-end fw-bold text-dark">@s.TotalAmount.ToString("N2") @s.Currency</td>
                                    <td class="text-end text-success">@s.PaidAmount.ToString("N2") @s.Currency</td>
                                    <td class="text-end fw-bold text-danger pe-4">@s.RemainingAmount.ToString("N2") @s.Currency</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Person Summary -->
    <div class="col-12 col-xl-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-light border-0 py-3">
                <h6 class="fw-bold mb-0 text-primary"><i class="fas fa-users me-2"></i> Kişi Bazlı Borç/Alacak</h6>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light small text-uppercase">
                            <tr>
                                <th class="ps-4">Kişi</th>
                                <th class="text-end">Toplam</th>
                                <th class="text-end pe-4">Kalan</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in Model.PersonSummaries)
                            {
                                <tr>
                                    <td class="ps-4 d-flex align-items-center">
                                        <div class="bg-light text-primary rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 32px; height: 32px; font-size: 0.8rem;">
                                            @s.Label[0]
                                        </div>
                                        <div>
                                            <div class="fw-bold">@s.Label</div>
                                            <small class="text-muted">@s.Currency</small>
                                        </div>
                                    </td>
                                    <td class="text-end fw-bold">@s.TotalAmount.ToString("N2") @s.Currency</td>
                                    <td class="text-end fw-bold text-danger pe-4">@s.RemainingAmount.ToString("N2") @s.Currency</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Main Table -->
<div class="card border-0 shadow-sm overflow-hidden">
    <div class="card-header bg-white border-0 py-3">
        <h5 class="fw-bold mb-0">Tüm Kayıtlar <span class="badge bg-light text-secondary rounded-pill fw-normal ms-2">@Model.FieldAccounts.Count</span></h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="fieldTable">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">Tarih</th>
                        <th>Kişi Adı</th>
                        <th>Açıklama</th>
                        <th class="text-end">Tutar</th>
                        <th class="text-center">Durum</th>
                        <th class="text-center pe-4">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.FieldAccounts)
                    {
                        <tr>
                            <td class="ps-4">@item.Date.ToString("dd.MM.yyyy")</td>
                            <td class="fw-bold">@item.PersonName</td>
                            <td>
                                <span class="text-truncate d-inline-block" style="max-width: 200px;" title="@item.Description">
                                    @(item.Description ?? "-")
                                </span>
                            </td>
                            <td class="text-end fw-bold">@item.Amount.ToString("N2") <small class="text-secondary">@item.CurrencyType</small></td>
                            <td class="text-center">
                                <form method="post" asp-page-handler="TogglePaid" asp-route-id="@item.Id">
                                    <button type="submit" class="btn btn-sm rounded-pill px-3 @(item.IsPaid ? "btn-success" : "btn-outline-danger")">
                                        @if (item.IsPaid) {
                                            <i class="fas fa-check-circle me-1"></i> <span class="small">Ödendi</span>
                                        } else {
                                            <i class="fas fa-clock me-1"></i> <span class="small">Bekliyor</span>
                                        }
                                    </button>
                                </form>
                            </td>
                            <td class="text-center pe-4">
                                <div class="btn-group">
                                    <button class="btn btn-light btn-sm rounded-circle me-1 edit-btn" 
                                            data-id="@item.Id"
                                            data-person="@item.PersonName"
                                            data-currency="@item.CurrencyType"
                                            data-amount="@item.Amount.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                            data-description="@item.Description"
                                            data-date="@item.Date.ToString("yyyy-MM-dd")"
                                            data-ispaid="@item.IsPaid.ToString().ToLower()"
                                            title="Düzenle">
                                        <i class="fas fa-edit text-primary"></i>
                                    </button>
                                    <form method="post" asp-page-handler="Delete" asp-route-id="@item.Id" class="d-inline" id="deleteForm_@item.Id">
                                        <button type="button" class="btn btn-light btn-sm rounded-circle" title="Sil" onclick="confirmDelete('deleteForm_@item.Id')">
                                            <i class="fas fa-trash text-danger"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        
        <!-- Pagination -->
        @if (Model.TotalPages > 1)
        {
            <nav aria-label="Page navigation" class="p-3">
                <ul class="pagination justify-content-center mb-0">
                    <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link rounded-circle me-1" asp-page="./Index" asp-route-p="@(Model.CurrentPage - 1)" aria-label="Önceki">
                            <span aria-hidden="true">&laquo;</span>
                        </a>
                    </li>
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                         <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                            <a class="page-link rounded-circle me-1" asp-page="./Index" asp-route-p="@i">@i</a>
                        </li>
                    }
                    <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                        <a class="page-link rounded-circle" asp-page="./Index" asp-route-p="@(Model.CurrentPage + 1)" aria-label="Sonraki">
                            <span aria-hidden="true">&raquo;</span>
                        </a>
                    </li>
                </ul>
            </nav>
        }

        @if (!Model.FieldAccounts.Any())
        {
            <div class="text-center py-5">
                <i class="fas fa-tractor text-light mb-3" style="font-size: 4rem;"></i>
                <h5 class="text-muted">Henüz kayıt bulunmuyor.</h5>
            </div>
        }
    </div>
</div>


<!-- Create Modal -->
<div class="modal fade" id="createModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-success text-white border-0">
                <h5 class="modal-title fw-bold">Yeni Kayıt Ekle</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" asp-page-handler="Create">
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-secondary">Kişi Adı</label>
                        <input type="text" class="form-control" name="PersonName" required>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-md-8">
                            <label class="form-label fw-bold small text-secondary">Tutar</label>
                            <input type="number" step="0.01" class="form-control" name="Amount" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold small text-secondary">Döviz</label>
                            <select class="form-select" name="CurrencyType" required>
                                <option value="₺">₺ (TL)</option>
                                <option value="$">$ (USD)</option>
                                <option value="€">€ (EUR)</option>
                                <option value="ALTIN">Altın</option>
                            </select>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-secondary">Açıklama</label>
                        <textarea class="form-control" name="Description" rows="2"></textarea>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-secondary">Tarih</label>
                            <input type="date" class="form-control" name="Date" value="@DateTime.Now.ToString("yyyy-MM-dd")" required>
                        </div>
                        <div class="col-md-6 d-flex align-items-end">
                            <div class="form-check form-switch mb-2 ms-2">
                                <input class="form-check-input" type="checkbox" name="IsPaid" value="true">
                                <label class="form-check-label small text-secondary">Ödendi mi?</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 p-4 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Vazgeç</button>
                    <button type="submit" class="btn btn-success rounded-pill px-4">Kaydet</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Modal -->
<div class="modal fade" id="editModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-primary text-white border-0">
                <h5 class="modal-title fw-bold">Kayıt Düzenle</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" asp-page-handler="Update">
                <input type="hidden" id="editId" name="Id" />
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-secondary">Kişi Adı</label>
                        <input type="text" class="form-control" id="editPersonName" name="PersonName" required>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-md-8">
                            <label class="form-label fw-bold small text-secondary">Tutar</label>
                            <input type="number" step="0.01" class="form-control" id="editAmount" name="Amount" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold small text-secondary">Döviz</label>
                            <select class="form-select" id="editCurrencyType" name="CurrencyType" required>
                                <option value="₺">₺ (TL)</option>
                                <option value="$">$ (USD)</option>
                                <option value="€">€ (EUR)</option>
                                <option value="ALTIN">Altın</option>
                            </select>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-secondary">Açıklama</label>
                        <textarea class="form-control" id="editDescription" name="Description" rows="2"></textarea>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-secondary">Tarih</label>
                            <input type="date" class="form-control" id="editDate" name="Date" required>
                        </div>
                        <div class="col-md-6 d-flex align-items-end">
                            <div class="form-check form-switch mb-2 ms-2">
                                <input class="form-check-input" type="checkbox" id="editIsPaid" name="IsPaid" value="true">
                                <label class="form-check-label small text-secondary">Ödendi mi?</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 p-4 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Vazgeç</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4">Güncelle</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('.edit-btn').on('click', function() {
                var btn = $(this);
                $('#editId').val(btn.data('id'));
                $('#editPersonName').val(btn.data('person'));
                $('#editCurrencyType').val(btn.data('currency'));
                $('#editAmount').val(btn.data('amount'));
                $('#editDescription').val(btn.data('description'));
                $('#editDate').val(btn.data('date'));
                $('#editIsPaid').prop('checked', btn.data('ispaid'));
                $('#editModal').modal('show');
            });
        });
    </script>
}
