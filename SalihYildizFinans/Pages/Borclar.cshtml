@page
@model SalihYildizFinans.Pages.BorclarModel
@{
    ViewData["Title"] = "Ekstre";
    var currentPeriodText = Model.PeriodList.ContainsKey(Model.SelectedPeriod) ? Model.PeriodList[Model.SelectedPeriod] : Model.SelectedPeriod;
    var trCulture = new System.Globalization.CultureInfo("tr-TR");
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-center mb-4 gap-3">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a href="/" class="text-decoration-none small">Anasayfa</a></li>
                <li class="breadcrumb-item active small" aria-current="page">Ekstre İşlemleri</li>
            </ol>
        </nav>
        <h2 class="fw-bold text-dark">Borç & Alacak Listesi</h2>
        <p class="text-secondary mb-0">@currentPeriodText dönemine ait işlemler.</p>
    </div>
    
    <div class="d-flex gap-2">
        <form method="get" class="d-flex align-items-center bg-white rounded shadow-sm p-1">
            <select name="period" class="form-select border-0 bg-transparent fw-bold text-primary" onchange="this.form.submit()">
                @foreach (var p in Model.PeriodList)
                {
                    <!option value="@p.Key" @(p.Key == Model.SelectedPeriod ? "selected" : "")>@p.Value</!option>
                }
            </select>
        </form>

        <div class="d-flex gap-2">
            <a href="?handler=Export&period=@Model.SelectedPeriod" class="btn btn-outline-success rounded-pill px-3 shadow-sm" title="Excel'e Aktar">
                <i class="fas fa-file-excel"></i>
            </a>
            
            <button class="btn btn-primary rounded-pill px-4 shadow-sm" onclick="openCreateModal()">
                <i class="fas fa-plus me-2"></i> Yeni Ekle
            </button>
        </div>
    </div>
</div>

<!-- Filters -->
<div class="d-flex justify-content-center mb-3">
    <div class="btn-group shadow-sm" role="group">
        <input type="radio" class="btn-check" name="statusFilter" id="filterAll" autocomplete="off" checked onchange="filterTable('all')">
        <label class="btn btn-outline-primary" for="filterAll">Tümü</label>

        <input type="radio" class="btn-check" name="statusFilter" id="filterUnpaid" autocomplete="off" onchange="filterTable('unpaid')">
        <label class="btn btn-outline-danger" for="filterUnpaid">Ödenmeyenler</label>

        <input type="radio" class="btn-check" name="statusFilter" id="filterPaid" autocomplete="off" onchange="filterTable('paid')">
        <label class="btn btn-outline-success" for="filterPaid">Ödenenler</label>
    </div>
</div>

<!-- Summary Cards for Selected Month -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card p-3 border-start border-4 border-primary shadow-sm h-100">
            <div class="text-secondary small fw-bold text-uppercase">@currentPeriodText GENEL TOPLAM</div>
            <div class="fs-4 fw-bold text-dark">@Model.PeriodTotalDebt.ToString("N2") ₺</div>
            <div class="text-muted small">Dönem içi toplam işlem tutarı</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-3 border-start border-4 border-danger shadow-sm h-100">
            <div class="text-secondary small fw-bold text-uppercase">@currentPeriodText BENİM PAYIM</div>
            <div class="fs-4 fw-bold text-danger">@Model.PeriodMyShare.ToString("N2") ₺</div>
            <div class="text-muted small">Toplam kişisel borç payı</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-3 border-start border-4 border-success shadow-sm h-100">
            <div class="text-secondary small fw-bold text-uppercase">@currentPeriodText ALACAK TOPLAMI</div>
            <div class="fs-4 fw-bold text-success">@Model.PeriodOthersShare.ToString("N2") ₺</div>
             <div class="text-muted small">Diğerlerinden alacaklar</div>
        </div>
    </div>
</div>

<!-- Responsive Table Wrapper -->
<div class="card p-4">
    <div class="table-responsive">
        <table id="debtsTable" class="table table-hover align-middle w-100 text-nowrap">
            <thead>
                <tr>
                    <th>Durum</th>
                    <th>Açıklama</th>
                    <th>Kategori/Banka</th>
                    <th>Tarih</th>
                    <th>Tutar</th>
                    <th>Benim Payım</th>
                    <th>Alacak/Diğer</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Transactions)
                {
                    var othersShare = item.TotalAmount - item.MyAmount;
                    <tr class="@(item.IsPaid ? "bg-light text-muted" : "")">
                         <td>
                            <form method="post" asp-page-handler="TogglePaid" asp-route-id="@item.Id" asp-route-period="@Model.SelectedPeriod" class="d-inline">
                                @if(item.IsPaid) {
                                    <button class="btn btn-sm btn-success rounded-pill px-3" title="Ödendi - Geri al">
                                        <i class="fas fa-check me-1"></i> Ödendi
                                    </button>
                                } else {
                                     <button class="btn btn-sm btn-outline-secondary rounded-pill px-3" title="Ödenmedi - Tamamla">
                                        <i class="fas fa-times me-1"></i> Ödenmedi
                                    </button>
                                }
                            </form>
                        </td>
                        <td>
                            <div class="fw-bold @(item.IsPaid ? "text-decoration-line-through" : "")">
                                @( string.IsNullOrEmpty(item.Description) ? "-(Açıklama Yok)-" : item.Description )
                            </div>
                        </td>
                        <td>
                            @if(item.Bank != null) {
                                <span class="badge bg-light text-dark border"><i class="fas fa-university me-1"></i> @item.Bank.Name</span>
                            } else {
                                <span class="badge bg-light text-secondary border">Diğer</span>
                            }
                        </td>
                        <td>@item.Date.ToShortDateString()</td>
                        <td class="fw-bold @(item.Type == SalihYildizFinans.Models.TransactionType.Borc ? "text-dark" : "text-success")">
                            @item.TotalAmount.ToString("N2") ₺
                        </td>
                         <td class="text-danger fw-bold small">
                            @item.MyAmount.ToString("N2") ₺
                        </td>
                        <td class="text-success fw-bold small">
                            @othersShare.ToString("N2") ₺
                        </td>
                        
                        <td class="text-end">
                            @if(!item.IsPaid) 
                            {
                                 <!-- Edit Button - Passing TR formatted strings with comma -->
                                 <button class="btn btn-sm btn-light text-primary me-1" 
                                    onclick="openEditModal(@item.Id, '@item.Description', '@item.BankId', '@item.TotalAmount.ToString("N2", trCulture)', '@item.MyAmount.ToString("N2", trCulture)', '@item.Period')">
                                     <i class="fas fa-edit"></i>
                                 </button>
    
                                 <!-- Delete Trigger -->
                                <form method="post" asp-page-handler="Delete" asp-route-id="@item.Id" asp-route-period="@Model.SelectedPeriod" class="d-inline" id="deleteBorcForm_@item.Id">
                                    <button type="button" class="btn btn-sm btn-light text-danger" onclick="confirmDelete('deleteBorcForm_@item.Id')">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            }
                            else
                            {
                                <span class="text-muted small fst-italic"><i class="fas fa-lock"></i> Kilitli</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal (Shared for Create & Edit) -->
<div class="modal fade" id="createModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-light border-0">
                <h5 class="modal-title fw-bold" id="modalTitle">Yeni Kayıt Ekle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" asp-page-handler="CreateOrUpdate">
                <input type="hidden" name="Id" id="inId" value="0">
                <input type="hidden" name="ReturnPeriod" value="@Model.SelectedPeriod">

                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-secondary">Açıklama</label>
                            <input type="text" class="form-control" name="Description" id="inDesc" placeholder="Örn: Market Fişi (Opsiyonel)">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-secondary">Banka</label>
                            <select class="form-select" name="BankId" id="inBankId" asp-items="Model.BankList">
                                <option value="">Seçiniz...</option>
                            </select>
                        </div>
                         <div class="col-md-12">
                            <label class="form-label fw-bold small text-secondary">Dönem (Ay)</label>
                             <select class="form-select" name="Period" id="inPeriod" required>
                                @foreach (var p in Model.PeriodList)
                                {
                                    <!option value="@p.Key" @(p.Key == Model.SelectedPeriod ? "selected" : "")>@p.Value</!option>
                                }
                            </select>
                        </div>
                         <div class="col-12"><hr class="my-2 border-0"></div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold small text-secondary">Toplam Tutar</label>
                            <div class="input-group">
                                <span class="input-group-text">₺</span>
                                <input type="text" class="form-control" name="TotalAmount" id="inTotal" required placeholder="0,00">
                            </div>
                        </div>
                         <div class="col-md-4">
                            <label class="form-label fw-bold small text-secondary">Benim Payım</label>
                            <div class="input-group">
                                <span class="input-group-text">₺</span>
                                <input type="text" class="form-control" name="MyAmount" id="inMyShare" required placeholder="0,00">
                            </div>
                        </div>
                         <div class="col-md-4">
                            <label class="form-label fw-bold small text-secondary">Alacak Payım</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted">₺</span>
                                <input type="text" class="form-control bg-light" id="inReceivable" readonly tabindex="-1">
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 p-4">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-primary px-4">Kaydet</button>
                </div>
            </form>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        $(document).ready(function() {
            $('#debtsTable').DataTable({
                "language": { "url": "//cdn.datatables.net/plug-ins/1.13.4/i18n/tr.json" },
                "dom": '<"d-flex justify-content-between align-items-center mb-3"f>t<"d-flex justify-content-between align-items-center mt-3"ip>',
                "ordering": false
            });

            const $total = $('#inTotal');
            const $myShare = $('#inMyShare');
            const $receivable = $('#inReceivable');

            function parseLocaleNumber(stringNumber) {
                var number = parseFloat(stringNumber.replace(',', '.').replace(/\s/g, ''));
                return isNaN(number) ? 0 : number;
            }

            function formatLocaleNumber(number) {
                 return number.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            }

            function calculate() {
                const totalStr = $total.val();
                const myStr = $myShare.val();
                
                const total = parseLocaleNumber(totalStr);
                const my = parseLocaleNumber(myStr);
                
                const res = total - my;
                
                // Show result in TR format
                $receivable.val(formatLocaleNumber(res));
            }
            $total.on('input', calculate);
            $myShare.on('input', calculate);
        });

        var createModal, deleteModal;
        
        function openCreateModal() {
            if(!createModal) createModal = new bootstrap.Modal(document.getElementById('createModal'));
            document.getElementById('modalTitle').innerText = 'Yeni Kayıt Ekle';
            document.getElementById('inId').value = '0';
            document.getElementById('inDesc').value = '';
            document.getElementById('inTotal').value = '';
            document.getElementById('inMyShare').value = '';
            document.getElementById('inReceivable').value = '';
            createModal.show();
        }

        function openEditModal(id, desc, bankId, total, myShare, period) {
            if(!createModal) createModal = new bootstrap.Modal(document.getElementById('createModal'));
            document.getElementById('modalTitle').innerText = 'Kaydı Düzenle';
            document.getElementById('inId').value = id;
            document.getElementById('inDesc').value = desc;
            document.getElementById('inBankId').value = bankId;
            document.getElementById('inPeriod').value = period;
            document.getElementById('inTotal').value = total;
            document.getElementById('inMyShare').value = myShare;
            $('#inTotal').trigger('input'); 
            createModal.show();
        }

        function openDeleteModal(id) {
             // Deleted - Using global confirmDelete
        }

        function filterTable(status) {
            var table = $('#debtsTable').DataTable();
            $.fn.dataTable.ext.search.pop(); // Remove existing filters

            if (status !== 'all') {
                $.fn.dataTable.ext.search.push(
                    function(settings, data, dataIndex) {
                         // Column 0 contains the button with text "Ödendi" or "Ödenmedi"
                         // Actually the text inside clean text is " Ödendi" or " Ödenmedi"
                         // Let's check the row class or look for specific content
                         // We added class "bg-light text-muted" to TR for paid items
                         // But DataTables data() usually gets text. 
                         // Let's search inside the first column HTML or text
                         
                         var statusText = $(table.row(dataIndex).node()).find('button').text().trim();
                         
                         if (status === 'paid') return statusText === 'Ödendi';
                         if (status === 'unpaid') return statusText === 'Ödenmedi';
                         return true; 
                    }
                );
            }
            table.draw();
        }
    </script>
}
