@page
@model SalihYildizFinans.Pages.Izinler.IndexModel
@{
    ViewData["Title"] = "İzin Yönetimi";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h2 class="fw-bold text-dark">İzin Kayıtları</h2>
        <p class="text-secondary mb-0">İzin ve mazeret sürelerinizi buradan takip edebilirsiniz.</p>
    </div>
    
    <button class="btn btn-primary rounded-pill px-4 shadow-sm" onclick="openCreateModal()">
        <i class="fas fa-plus me-2"></i> Yeni İzin Ekle
    </button>
</div>

<!-- Özet Rapor Alanı (Tamamlanmamışlar) -->
<div class="row g-3 mb-4">
    <div class="col-12">
        <div class="card p-4 border-0 shadow-sm bg-gradient-primary text-white" style="background: linear-gradient(135deg, #4e73df 0%, #224abe 100%);">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <h5 class="fw-bold mb-1"><i class="fas fa-chart-pie me-2"></i> Bekleyen İzin Özeti</h5>
                    <p class="small mb-0 opacity-75">Henüz "Tamamlandı" olarak işaretlenmemiş izinlerinizin toplam süresi.</p>
                </div>
                <div class="col-md-4 text-md-end mt-3 mt-md-0">
                    <div class="d-flex justify-content-md-end gap-3">
                        <div class="text-center">
                            <div class="fs-3 fw-bold">@Model.SummaryTotalDays</div>
                            <div class="small opacity-75">Gün</div>
                        </div>
                        <div class="text-center border-start border-white border-opacity-25 ps-3">
                            <div class="fs-3 fw-bold">@Model.SummaryTotalHours</div>
                            <div class="small opacity-75">Saat</div>
                        </div>
                        <div class="text-center border-start border-white border-opacity-25 ps-3">
                            <div class="fs-3 fw-bold">@Model.SummaryTotalMinutes</div>
                            <div class="small opacity-75">Dakika</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- İzin Listesi -->
<div class="card p-4">
    <div class="table-responsive">
        <table id="leavesTable" class="table table-hover align-middle w-100 text-nowrap">
            <thead>
                <tr>
                    <th>Durum</th>
                    <th>Açıklama</th>
                    <th>Başlangıç</th>
                    <th>Bitiş</th>
                    <th>Süre (G:S:D)</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Leaves)
                {
                    <tr class="@(item.IsCompleted ? "bg-light text-muted" : "")">
                        <td>
                            <form method="post" asp-page-handler="ToggleStatus" asp-route-id="@item.Id" class="d-inline">
                                @if(item.IsCompleted) {
                                    <button class="btn btn-sm btn-success rounded-pill px-3" title="Tamamlandı - Geri al">
                                        <i class="fas fa-check me-1"></i> Tamamlandı
                                    </button>
                                } else {
                                     <button class="btn btn-sm btn-outline-warning rounded-pill px-3" title="Bekliyor - Tamamla">
                                        <i class="fas fa-clock me-1"></i> Bekliyor
                                    </button>
                                }
                            </form>
                        </td>
                        <td>
                            <div class="fw-bold @(item.IsCompleted ? "text-decoration-line-through" : "")">
                                @item.Description
                            </div>
                        </td>
                        <td>@item.StartDate.ToString("g")</td>
                        <td>@item.EndDate.ToString("g")</td>
                        <td>
                            <span class="badge bg-light text-dark border p-2">
                                <i class="fas fa-hourglass-half me-1 text-primary"></i> 
                                @item.TotalDays G, @item.TotalHours S, @item.TotalMinutes D
                            </span>
                        </td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-light text-primary me-1" onclick="openEditModal(@item.Id, '@item.Description', '@item.StartDate.ToString("yyyy-MM-ddTHH:mm")', '@item.EndDate.ToString("yyyy-MM-ddTHH:mm")', @item.TotalDays, @item.TotalHours, @item.TotalMinutes)">
                                <i class="fas fa-edit"></i>
                            </button>
                            <form method="post" asp-page-handler="Delete" asp-route-id="@item.Id" class="d-inline" id="deleteLeaveForm_@item.Id">
                                <button type="button" class="btn btn-sm btn-light text-danger" onclick="confirmDelete('deleteLeaveForm_@item.Id')">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Yeni/Düzenle İzin Modalı -->
<div class="modal fade" id="createModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-light border-0">
                <h5 class="modal-title fw-bold" id="modalTitle">Yeni İzin Kaydı</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" id="leaveForm">
                <input type="hidden" name="Id" id="inId" value="0">
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label fw-bold small text-secondary">Açıklama</label>
                            <input type="text" class="form-control" name="Description" id="inDesc" required placeholder="İzin nedenini yazınız...">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-secondary">Başlangıç Tarihi ve Saat</label>
                            <input type="datetime-local" class="form-control" name="StartDate" id="inStart" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-secondary">Bitiş Tarihi ve Saat</label>
                            <input type="datetime-local" class="form-control" name="EndDate" id="inEnd" required>
                        </div>
                        <div class="col-12"><hr class="my-2 border-0"></div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold small text-secondary">Toplam Gün</label>
                            <input type="number" class="form-control" name="TotalDays" id="inDays" value="0" min="0">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold small text-secondary">Toplam Saat</label>
                            <input type="number" class="form-control" name="TotalHours" id="inHours" value="0" min="0" max="23">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold small text-secondary">Toplam Dakika</label>
                            <input type="number" class="form-control" name="TotalMinutes" id="inMins" value="0" min="0" max="59">
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 p-4">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-primary px-4">Kaydet</button>
                </div>
            </form>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        $(document).ready(function() {
            $('#leavesTable').DataTable({
                "language": { "url": "//cdn.datatables.net/plug-ins/1.13.4/i18n/tr.json" },
                "ordering": false // Backend'den tarih sırasıyla geliyor (StartDate DESC)
            });
        });

        var createModal, deleteModal;
        
        function openCreateModal() {
            if(!createModal) createModal = new bootstrap.Modal(document.getElementById('createModal'));
            document.getElementById('modalTitle').innerText = 'Yeni İzin Kaydı';
            document.getElementById('leaveForm').action = '?handler=Create';
            document.getElementById('inId').value = '0';
            document.getElementById('inDesc').value = '';
            document.getElementById('inStart').value = '';
            document.getElementById('inEnd').value = '';
            document.getElementById('inDays').value = '0';
            document.getElementById('inHours').value = '0';
            document.getElementById('inMins').value = '0';
            createModal.show();
        }

        function openEditModal(id, desc, start, end, days, hours, mins) {
            if(!createModal) createModal = new bootstrap.Modal(document.getElementById('createModal'));
            document.getElementById('modalTitle').innerText = 'İzin Kaydını Düzenle';
            document.getElementById('leaveForm').action = '?handler=Update';
            document.getElementById('inId').value = id;
            document.getElementById('inDesc').value = desc;
            document.getElementById('inStart').value = start;
            document.getElementById('inEnd').value = end;
            document.getElementById('inDays').value = days;
            document.getElementById('inHours').value = hours;
            document.getElementById('inMins').value = mins;
            createModal.show();
        }

        function openDeleteModal(id) {
             // Deleted - Using global confirmDelete instead
        }
    </script>
}
